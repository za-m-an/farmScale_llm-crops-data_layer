# ML Seam Configuration
ML_MODE=mock
ML_HTTP_URL=http://localhost:8001
ML_TIMEOUT_SECONDS=15

# LLM Server-Side Optional Default Keys (never required; keys can arrive per request)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# API Security & Rate Limiting
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=60
LLM_TIMEOUT_SECONDS=30

# Telemetry Unit Configuration (check with ML integrator)
PRECIP_UNIT=mm/day
